{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug embedding",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/ai_tour_guide/ingestion/embedding.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "tmp/guide-discover-brittany-chunks.json",
        "--output",
        "tmp/guide-discover-brittany-embedded.json"
      ]
    },
    {
      "name": "Debug agent: ask",
      "type": "debugpy",
      "request": "launch",
      "module": "ai_tour_guide.agent",
      "args": [
        "ask",
        "--k",
        "5",
        "What are the main cities of Brittany?"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
