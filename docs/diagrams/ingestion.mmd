flowchart LR
    %% -------------------------
    %% Entry / Exit
    %% -------------------------
    START([Start])
    END([End])

    %% -------------------------
    %% Ingestion
    %% -------------------------
    subgraph ING[Document Ingestion]
        direction LR
        A[Download] --> B[Parse] --> C[Chunk] --> D[Tokenize] --> E[Embed]
    end

    %% -------------------------
    %% Shared component
    %% -------------------------
    KB[(Knowledge Base)]

    %% Entry / Exit connections
    START --> A
    E --> END

    %% Ingestion output
    E --> KB

    %% -------------------------
    %% Styling
    %% -------------------------
    classDef ingestion fill:#eef6ff,stroke:#4a90e2,stroke-width:1.5px;
    classDef shared fill:#fff7e6,stroke:#d99000,stroke-width:2px;
    classDef startNode fill:#198754,color:#ffffff,stroke:#146c43,stroke-width:3px,font-weight:bold;
    classDef endNode fill:#dc3545,color:#ffffff,stroke:#b02a37,stroke-width:3px,font-weight:bold;

    class A,B,C,D,E ingestion;
    class KB shared;
    class START startNode;
    class END endNode;
