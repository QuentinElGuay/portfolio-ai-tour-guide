flowchart TB
    %% -------------------------
    %% Entry / Exit
    %% -------------------------
    START([Start])
    END([End])

    %% -------------------------
    %% Ingestion
    %% -------------------------
    subgraph ING[Document Ingestion]
        direction LR
        A[Download] --> B[Parse] --> C[Chunk] --> D[Tokenize] --> E[Embed]
    end

    %% -------------------------
    %% Shared components
    %% -------------------------
    KB[(Knowledge Base)]
    LLM[LLM Model]

    %% -------------------------
    %% RAG
    %% -------------------------
    subgraph RAG[RAG]
        direction LR
        Q1[Question] --> T1[Tokenize] --> V1[Embed] --> S1[Search]
        R1[Retrieve] --> BD[Best Documents]
    end

    %% -------------------------
    %% Agent
    %% -------------------------
    subgraph AG[Agent]
        direction LR
        Q2[Question] --> R2[Reason] --> O2[Response]
    end

    %% -------------------------
    %% Tools
    %% -------------------------
    subgraph TOOLS[Tools]
        direction LR
        W[Weather Service]
        BKG[Booking Service]
    end

    %% Entry / Exit connections
    START --> Q2
    O2 --> END

    %% Ingestion output
    E --> KB

    %% RAG interactions
    S1 --> KB
    KB --> R1

    %% Agent interactions
    R2 <--> LLM
    R2 <--> TOOLS
    R2 <--> RAG

    %% -------------------------
    %% Styling
    %% -------------------------
    classDef ingress fill:#eef6ff,stroke:#4a90e2,stroke-width:1.5px;
    classDef rag fill:#f5f0ff,stroke:#7b61ff,stroke-width:1.5px;
    classDef agent fill:#eefcf3,stroke:#2f9e44,stroke-width:1.5px;
    classDef shared fill:#fff7e6,stroke:#d99000,stroke-width:2px;
    classDef tool fill:#f5f0ff,stroke:#7b61ff,stroke-width:1.5px;
    classDef terminal fill:#111111,color:#ffffff,stroke:#111111,stroke-width:2.5px;

    classDef startNode fill:#198754,color:#ffffff,stroke:#146c43,stroke-width:3px,font-weight:bold;
    classDef endNode fill:#dc3545,color:#ffffff,stroke:#b02a37,stroke-width:3px,font-weight:bold;

    class A,B,C,D,E ingress;
    class Q1,T1,V1,S1,R1,BD rag;
    class Q2,R2,O2 agent;
    class KB,LLM shared;
    class W,BKG tool;
    class START startNode;
    class END endNode;
